{
  "name": "shifts-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "pnpm --filter @shifts/web dev",
    "dev:clean": "pnpm --filter @shifts/web exec rm -rf .next && pnpm --filter @shifts/web dev",
    "build": "pnpm --filter @shifts/web build",
    "build:gh-pages": "NEXT_PUBLIC_BASE_PATH=/shifts-app pnpm --filter @shifts/web build",
    "clean": "pnpm --filter @shifts/web exec rm -rf .next out",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "prepare": "husky",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "format": "prettier --write .",
    "verify": "pnpm run lint && pnpm run format && pnpm run typecheck && pnpm run test"
  },
  "devDependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/camelcase-keys": "^5.1.5",
    "@types/node": "^26.4.0",
    "@types/snakecase-keys": "^3.1.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/ui": "^4.1.11",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "typescript": "catalog:",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "typescript": "6.0.0"
  },
  "dependencies": {
    "camelcase-keys": "^10.0.2",
    "date-fns": "catalog:",
    "next": "16.3.4",
    "snakecase-keys": "^9.0.2",
    "zustand": "catalog:"
  }
}
